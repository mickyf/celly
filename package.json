{
  "name": "celly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sentry": "VITE_SENTRY_RELEASE=$(git rev-parse --short HEAD) npm run build",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gen-types": "npx supabase gen types typescript --linked > src/types/database.ts",
    "gen-icons": "node scripts/generate-icons.js",
    "prepare": "husky",
    "typecheck": "tsc -b && tsc -p mcp-server --noEmit"
  },
  "dependencies": {
    "@mantine/charts": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/dropzone": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-devtools": "^1.167.1",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sharp": "^0.35.4",
    "supabase": "^2.116.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
